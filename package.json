{
  "name": "decksoundpad",
  "version": "0.1.28",
  "description": "Decky Loader soundboard that mixes sounds with the real microphone into a virtual mic.",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "package": "scripts/package_plugin.sh",
    "watch": "rollup -c -w",
    "test": "python3 -m unittest discover backend/tests"
  },
  "repository": {
    "type": "git",
    "url": ""
  },
  "keywords": [
    "decky",
    "steam-deck",
    "soundboard",
    "pipewire",
    "microphone"
  ],
  "author": "DeckSoundpad contributors",
  "license": "MIT",
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@decky/ui": "^4.11.0",
    "@rollup/rollup-linux-x64-musl": "^4.53.3",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "rollup": "^4.53.3",
    "typescript": "^5.6.2"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "react-icons": "^5.3.0",
    "react-router": "^7.17.0",
    "tslib": "^2.7.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    }
  },
  "packageManager": "pnpm@8.15.9"
}
